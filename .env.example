DATABASE_URL=postgresql://postgres.<project>:***@<host>:6543/postgres
# Aplikasi memakai DIRECT_URL (mode session, port 5432) bila tersedia; pooler mode
# transaksi (6543) membuat request menggantung karena socket bisa kehilangan backend.
DIRECT_URL=postgresql://postgres.<project>:***@<host>:5432/postgres
AUTH_SECRET=<openssl rand -base64 32>
AUTH_URL=http://localhost:3000
# Opsional: isi keduanya agar tombol "Masuk dengan Google" muncul. Kosongkan bila login cukup email+sandi.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email (undangan, verifikasi, reset). Tanpa RESEND_API_KEY, email hanya dicatat di log server.
RESEND_API_KEY=
EMAIL_FROM=UMKM-AI <onboarding@resend.dev>
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=umkm-ai-private
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Opsional: tarif token (rupiah per 1 juta token) agar panel platform bisa menaksir biaya AI.
# Kosongkan bila tidak ingin angka biaya ditampilkan.
AI_COST_INPUT_PER_MTOK=
AI_COST_OUTPUT_PER_MTOK=
# Tugas terjadwal (invoice kedaluwarsa, pengingat Pro, retensi audit).
# Vercel Cron memanggil /api/cron/notifications harian; isi dengan nilai acak panjang.
CRON_SECRET=
